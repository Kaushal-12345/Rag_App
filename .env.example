# Copy to .env and fill in values. Never commit .env.

# --- LLM (any OpenAI-compatible API: Groq, OpenRouter, ...) ---------------
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1

# The three open-source models. Names must exist at your provider
# (list them with: curl -s $LLM_BASE_URL/models -H "Authorization: Bearer $LLM_API_KEY").
LLM_MODEL_1=openai/gpt-oss-120b
LLM_MODEL_2=qwen/qwen3.8-27b
LLM_MODEL_3=openai/gpt-oss-20b
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=90

# --- Web search -------------------------------------------------------------
# Optional. Free key at https://tavily.com. Without it, DuckDuckGo (no key) is used.
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=4

# --- Retrieval --------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVE_TOP_K=5
MAX_HISTORY_MESSAGES=6
# Cross-encoder reranking: better answers, slower first request (downloads a model).
RERANK_ENABLED=false

# --- Robustness -------------------------------------------------------------
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=60
OCR_ENABLED=true          # needs Tesseract (brew install tesseract); skipped if missing
WHISPER_FALLBACK=false    # needs requirements-optional.txt + ffmpeg

# --- App --------------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated list of frontend URLs allowed to call the API.
CORS_ORIGINS=http://localhost:3000
